{
  "name": "@jginorio/sprout-social-mcp",
  "version": "1.0.0",
  "description": "Unofficial community MCP server for the Sprout Social API — use it while Sprout Social works on their official one. Provides tools for social media analytics, post management, publishing, and more.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sprout-social-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sprout-social",
    "social-media",
    "analytics",
    "ai",
    "llm"
  ],
  "author": "Jaime Ginorio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jginorio/sprout-social-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
